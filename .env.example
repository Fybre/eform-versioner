# Port the app listens on
PORT=3000

# Where the SQLite database (offline snapshots + form catalog cache) is stored
DATA_DIR=./data

# Secret used to sign the session cookie. REQUIRED — set a long random value,
# e.g.: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-random-string

# Set to "true" once the app is served over HTTPS so session cookies get the Secure flag
COOKIE_SECURE=false
